    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@portfolio/knowledge": "0.1.0",
    "@portfolio/mcp-server": "0.1.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
