{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "bannerSkills": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "cv",
              "repository",
              "documentation",
              "profile",
              "store-listing",
              "website",
              "author-statement"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "label",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "status": {
            "default": "verified",
            "type": "string",
            "enum": [
              "verified",
              "unverified"
            ]
          }
        },
        "required": [
          "text",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+\\d[\\d ]{6,18}\\d$"
        },
        "links": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "live",
                  "source",
                  "store",
                  "documentation",
                  "website",
                  "profile"
                ]
              }
            },
            "required": [
              "label",
              "url",
              "kind"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "email"
      ],
      "additionalProperties": false
    },
    "experience": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "organisation": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "projects": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "status": {
            "default": "verified",
            "type": "string",
            "enum": [
              "verified",
              "unverified"
            ]
          }
        },
        "required": [
          "organisation",
          "role",
          "period",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "education": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "qualification": {
            "type": "string",
            "minLength": 1
          },
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "status": {
            "default": "verified",
            "type": "string",
            "enum": [
              "verified",
              "unverified"
            ]
          }
        },
        "required": [
          "qualification",
          "institution",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "certifications": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "progress": {
            "type": "string",
            "enum": [
              "earned",
              "in-progress"
            ]
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "status": {
            "default": "verified",
            "type": "string",
            "enum": [
              "verified",
              "unverified"
            ]
          }
        },
        "required": [
          "name",
          "issuer",
          "progress",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "languages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "status": {
            "default": "verified",
            "type": "string",
            "enum": [
              "verified",
              "unverified"
            ]
          }
        },
        "required": [
          "language",
          "level",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "workingApproach": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "status": {
                "default": "verified",
                "type": "string",
                "enum": [
                  "verified",
                  "unverified"
                ]
              }
            },
            "required": [
              "title",
              "description",
              "sources"
            ],
            "additionalProperties": false
          }
        },
        "ai": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "status": {
                "default": "verified",
                "type": "string",
                "enum": [
                  "verified",
                  "unverified"
                ]
              }
            },
            "required": [
              "text",
              "sources"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "summary",
        "steps"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "title",
    "location",
    "bannerSkills",
    "sources",
    "summary",
    "contact"
  ],
  "additionalProperties": false
}
