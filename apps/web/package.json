{
  "name": "@portfolio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "knowledge": "npm --prefix ../../packages/knowledge run build --silent",
    "dev": "npm run knowledge && next dev",
    "build": "npm run knowledge && next build",
