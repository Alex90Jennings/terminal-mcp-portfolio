# Copy to .env.local for local development. Never commit real values.

# ── Rate limiting (required in production) ───────────────────────────────────
# Production needs a limiter shared by every serverless instance: Upstash Redis.
# Without these, the MCP endpoint answers 503 rather than running unlimited.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# "upstash" (default in production) or "memory" (default in development).
# "memory" is refused on Vercel; elsewhere it must be set explicitly, e.g. for
# a local `next start` or the Playwright suite.
# RATE_LIMIT_BACKEND=

# Requests per minute per client on /api/mcp (1–1000). Default 60.
# MCP_RATE_LIMIT_PER_MINUTE=60

# When a *configured* Upstash errors or times out: "open" (default for MCP,
# which is read-only and free) lets requests through; "closed" refuses them.
# Missing credentials always refuse, whatever this says.
# MCP_RATE_LIMIT_FAILURE_MODE=open

# ── MCP endpoint access ──────────────────────────────────────────────────────
# Browser origins allowed to call /api/mcp. "*" (default) accepts any https
# origin plus http on localhost; or give a comma-separated allow-list.
# MCP_ALLOWED_ORIGINS=*

# Extra Host names this deployment answers to, comma-separated (no scheme).
# Vercel's own deployment hosts are added automatically; add any other custom
# domains here, e.g. both the apex and www.
# MCP_ALLOWED_HOSTS=

# ── AI assistant ─────────────────────────────────────────────────────────────
# Development defaults to the scripted model (no keys, no cost). Production
# needs AI_PROVIDER, CHAT_TRANSCRIPT_SECRET and the Upstash variables above.
# AI_ENABLED=true
# AI_PROVIDER=anthropic               # anthropic | bedrock | scripted
# AI_MODEL=claude-haiku-5-5           # claude-haiku-5-5 (default) | claude-sonnet-5-5 | claude-opus-5-5
# AI_EFFORT=medium                   # low | medium | high

# Bedrock: on Vercel, an IAM role assumed through OIDC (infra/bedrock). Locally,
# the standard AWS credential chain (e.g. AWS_PROFILE) is used instead.
# AI_BEDROCK_ROLE_ARN=
# AI_BEDROCK_REGION=eu-west-1

# Claude API, if AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=

# Signs conversation history so visitors can't forge earlier answers. 32+ characters.
CHAT_TRANSCRIPT_SECRET=

# Spend and abuse limits (defaults shown).
# AI_DAILY_BUDGET_USD=10
# AI_MONTHLY_BUDGET_USD=50
# Per-answer limits. The budget reservation is derived from these and the model's price
# (Haiku 5.5 defaults: 4 × (24,000 input + 2,048 output tokens) = $0.016096 per answer;
# Opus 5.5 would be $0.64384). Output includes the model's thinking.
# AI_MAX_OUTPUT_TOKENS=2048
# AI_MAX_INPUT_TOKENS_PER_CALL=24000
# AI_MAX_TOOL_ROUNDS=4
# AI_TIMEOUT_MS=30000
# AI_QUESTIONS_PER_MINUTE=5
# AI_QUESTIONS_PER_DAY=30

# Alex's CV, streamed by GET /api/cv from a private S3 bucket using Vercel OIDC (docs/CV_DOWNLOAD.md).
# All four must be set (production, on Vercel) for the `cv` command to offer the download. None is secret.
# CV_S3_BUCKET=cv-alex-jennings
# CV_S3_KEY=cv-alex-jennings.pdf
# CV_S3_REGION=eu-west-1
# CV_AWS_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/VercelPortfolioCVRole
