# Copy to .env.local for local development. Never commit real values.

# ── Rate limiting (required in production) ───────────────────────────────────
# Production needs a limiter shared by every serverless instance: Upstash Redis.
# Without these, the MCP endpoint answers 503 rather than running unlimited.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# "upstash" (default in production) or "memory" (default in development).
# "memory" is refused on Vercel; elsewhere it must be set explicitly, e.g. for
# a local `next start` or the Playwright suite.
# RATE_LIMIT_BACKEND=

# Requests per minute per client on /api/mcp (1–1000). Default 60.
# MCP_RATE_LIMIT_PER_MINUTE=60

# When a *configured* Upstash errors or times out: "open" (default for MCP,
# which is read-only and free) lets requests through; "closed" refuses them.
# Missing credentials always refuse, whatever this says.
# MCP_RATE_LIMIT_FAILURE_MODE=open

# ── MCP endpoint access ──────────────────────────────────────────────────────
# Browser origins allowed to call /api/mcp. "*" (default) accepts any https
# origin plus http on localhost; or give a comma-separated allow-list.
# MCP_ALLOWED_ORIGINS=*

# Extra Host names this deployment answers to, comma-separated (no scheme).
# Vercel's own deployment hosts are added automatically; add any other custom
# domains here, e.g. both the apex and www.
# MCP_ALLOWED_HOSTS=
